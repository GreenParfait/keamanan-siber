              "threats": [
                {
                  "id": "ab689162-2d18-4d72-beed-b4aac6f28b7d",
                  "title": "Penyangkalan pembukaan/penutupan sesi dan pencatatan presensi karena jejak audit tidak memadai",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Repudiation",
                  "description": "Skenario: Jika aksi buka/tutup sesi atau pencatatan presensi tidak tercatat lengkap, maka dosen atau mahasiswa dapat menyangkal tindakannya dan sengketa kehadiran sulit dibuktikan.\nDampak: Sengketa presensi tidak dapat diselesaikan; akuntabilitas lemah.\nAsumsi: log aplikasi hanya mencatat error, bukan aksi pengguna.\nPenilaian: Kemungkinan 2 x Dampak 2 = 4 (Medium).",
                  "mitigation": "Catat audit log (waktu, ID pengguna, ID sesi, IP, hasil) untuk buka/tutup sesi dan presensi; simpan append-only dengan akses tulis terbatas; sinkronkan waktu server.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 3,
                  "score": "4"
                },
                {
                  "id": "215b84bf-c078-4393-a013-a68557eecb06",
                  "title": "Banjir request scan menjelang akhir sesi membuat Backend Presensi lambat atau tidak tersedia",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Denial of Service",
                  "description": "Skenario: Jika banyak request scan (sah atau otomatis) dikirim bersamaan menjelang sesi lima menit berakhir, maka Backend Presensi dan database kelebihan beban sehingga mahasiswa gagal presensi.\nDampak: Sebagian/seluruh kelas tidak dapat presensi; layanan terganggu.\nAsumsi: belum ada rate limiting pada endpoint presensi.\nPenilaian: Kemungkinan 2 x Dampak 2 = 4 (Medium).",
                  "mitigation": "Rate limiting per akun/IP; cache status sesi; antrian dan timeout; pantau lonjakan trafik; respons idempoten untuk request ulang.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 5,
                  "score": "4"
                }
              ],
