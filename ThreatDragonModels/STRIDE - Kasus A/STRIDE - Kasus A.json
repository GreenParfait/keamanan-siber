            "data": {
              "description": "",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "threats": [
                {
                  "id": "dfc1838b-2c76-4065-9bfb-c53fa7063d45",
                  "title": "Pemalsuan identitas mahasiswa untuk titip absen melalui akun/token teman",
                  "status": "Open",
                  "severity": "High",
                  "type": "Spoofing",
                  "description": "Skenario: Jika mahasiswa lain dapat memakai akun/token milik temannya (atau meneruskan sesi login) untuk memindai QR, maka kehadiran tercatat atas nama mahasiswa yang sebenarnya tidak hadir.\nDampak: Integritas data kehadiran rusak; hadir palsu dan keadilan akademik terganggu.\nAsumsi: login hanya memakai kata sandi, tanpa pengikatan perangkat.\nPenilaian: Kemungkinan 3 x Dampak 2 = 6 (High).",
                  "mitigation": "Ikat token ke sesi login dan perangkat; wajibkan autentikasi ulang/MFA saat presensi; deteksi satu perangkat/IP mengirim presensi untuk banyak akun; masa berlaku token pendek.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 1,
                  "score": "6"
                },
                {
                  "id": "7979d3ad-abe8-4d45-a439-eec41ebae970",
                  "title": "Manipulasi ID sesi atau token QR pada request scan untuk presensi sesi/kelas lain",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "Skenario: Jika pengguna dapat mengubah ID sesi, ID kelas, atau token QR pada request F5, maka presensi bisa tercatat pada sesi lain atau sesi yang sudah kedaluwarsa.\nDampak: Catatan kehadiran tidak sah masuk Database Akademik; rekap tidak akurat.\nAsumsi: parameter kelas/sesi dikirim dari klien.\nPenilaian: Kemungkinan 2 x Dampak 3 = 6 (High).",
                  "mitigation": "Tandatangani token QR (HMAC/JWT) dan verifikasi di server; turunkan kelas dari sesi di server, bukan dari parameter klien; cek masa berlaku 5 menit dan keanggotaan kelas pada tiap request.",
                  "modelType": "STRIDE",
