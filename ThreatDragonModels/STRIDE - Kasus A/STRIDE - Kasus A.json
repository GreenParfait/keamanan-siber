              "hasOpenThreats": true,
              "threats": [
                {
                  "id": "6ec6d636-a500-4f59-b3a8-43188d56b16b",
                  "title": "Mahasiswa memanggil endpoint buka/tutup sesi milik dosen",
                  "status": "Open",
                  "severity": "High",
                  "type": "Elevation of Privilege",
                  "description": "Skenario: Jika mahasiswa dapat mengirim request buka/tutup sesi (F4) langsung ke backend dan otorisasi hanya disembunyikan di antarmuka, maka ia dapat membuka sesi kelas atau menutup sesi dosen.\nDampak: Sesi presensi dikuasai pihak tidak berwenang; integritas presensi hilang.\nAsumsi: pembatasan peran sebagian hanya di UI.\nPenilaian: Kemungkinan 2 x Dampak 3 = 6 (High).",
                  "mitigation": "RBAC deny-by-default di backend; baca peran dari token tepercaya di server; pastikan pemanggil adalah dosen pengampu kelas tersebut; uji akses antar-peran.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 6,
                  "score": "6"
                }
              ],
